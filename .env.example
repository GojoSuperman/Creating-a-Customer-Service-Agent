OPENAI_API_KEY=sk-...
# 선택
# ROUTER_MODEL=gpt-4.1-mini
# ANSWER_MODEL=gpt-4.1
# DOMAIN=modumall
# CONF_THRESHOLD=0.5
# TTS_MODEL=gpt-4o-mini-tts   # 유료 OpenAI 음성. 비우면(기본) 브라우저 음성만 사용 (무료)
# TTS_VOICE=nova              # alloy, nova, shimmer, echo 등
# CLARIFY_MAX=1   # 확신도 미달 시 되묻는 횟수 (0이면 즉시 이관)
# JUDGE_MODEL=gpt-4.1-mini   # eval_answer --judge 가 쓰는 채점 모델
# CONF_MARGIN=0.3   # 1순위-2순위 확신도 차이가 이보다 작으면 되묻기/이관. eval_hard 격자(2026-09-17)에서 경계모호 위험 15→8, 비모호 오이관 3 으로 정함
# FOLLOWUP_INHERIT=0   # 1 이면 is_followup 인 후속 발화가 직전 라우트를 강제로 이어받음. 멀티턴 측정(2026-09-17)에서 순손실이라 기본 꺼짐
# HOST=0.0.0.0          # 외부 접속을 받을 때만(레일웨이 등). 기본은 127.0.0.1(로컬 전용)
# ADMIN_PASSWORD=        # /admin/* 전체에 HTTP Basic 인증(사용자명 admin). 공개 배포에는 필수 — 비우면 fail-closed 로 /admin/* 이 503
# ALLOW_OPEN_ADMIN=      # 1 이면 ADMIN_PASSWORD 없이도 어드민 무인증 허용(로컬 개발 전용, 공개 배포 금지)
